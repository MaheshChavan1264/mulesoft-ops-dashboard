# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-random-string
SESSION_DB_DIR=./data
SESSION_MAX_AGE_MS=86400000
LOG_LEVEL=info

# Comma-separated list of allowed frontend origins (credentials: true requires
# exact origins — no wildcards). Defaults to the Vite/CRA local dev ports.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Anypoint Platform ─────────────────────────────────────────────────────────
ANYPOINT_PLATFORM_URL=https://anypoint.mulesoft.com

# ── TLS trust for CPS / ping / internal HTTPS calls ─────────────────────────
# PEM bundle for the internal/self-signed CA used by CPS servers and internal
# app ping targets. When unset, TLS verification is disabled for those calls
# only (never for Anypoint itself) and a one-time warning is logged.
CPS_CA_CERT_PATH=

# ── Encryption key for CPS client secrets at rest in the session store ──────
# Optional — falls back to SESSION_SECRET when unset.
CPS_CREDS_ENC_KEY=

# ── Rate limiting ────────────────────────────────────────────────────────────
# All limiters below only enforce when NODE_ENV=production, unless
# RATE_LIMIT_ENFORCE_DEV=true (useful for testing limiter behaviour locally).
RATE_LIMIT_ENFORCE_DEV=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
SEARCH_USER_RATE_LIMIT_WINDOW_MS=60000
SEARCH_USER_RATE_LIMIT_MAX=10

# ── CPS (Configuration Property Server) Credentials ─────────────────────────
# Each entry = client_id + client_secret for a specific deployment type × env.
# Leave blank if you prefer to enter them via the UI settings modal.
#
# CH1 = CloudHub 1.0 apps   CH2 = CloudHub 2.0 apps
# PROD = production CPS     UAT  = UAT/staging CPS

CPS_CH1_PROD_CLIENT_ID=
CPS_CH1_PROD_CLIENT_SECRET=

CPS_CH2_PROD_CLIENT_ID=
CPS_CH2_PROD_CLIENT_SECRET=

CPS_CH1_UAT_CLIENT_ID=
CPS_CH1_UAT_CLIENT_SECRET=

CPS_CH2_UAT_CLIENT_ID=
CPS_CH2_UAT_CLIENT_SECRET=